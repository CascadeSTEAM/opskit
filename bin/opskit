#!/usr/bin/env python3
"""
opskit — unified CLI for network operations.

  opskit env --create my-env --subnets 192.0.2.0/24  scaffold a new environment
  opskit env my-env                                switch to environment
  opskit env                                       show active environment
  opskit init [path]                               scaffold OpsKit member manifest
  opskit scan                                      full scan pipeline
  opskit status                                    inventory summary
  opskit lint                                      inventory vs device record check
  opskit setup-completion bash                     install tab completion

Every command reads from environments/<env>/env.yml.  No hardcoded hostnames.
"""

from __future__ import annotations
import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Optional

SCRIPT_DIR = Path(__file__).resolve().parent
# OPSKIT_ROOT override exists for tests (point at a temp repo root).
REPO_ROOT = Path(os.environ.get('OPSKIT_ROOT') or SCRIPT_DIR.parent)
sys.path.insert(0, str(SCRIPT_DIR.parent))

import yaml


# ═══════════════════════════════════════════════════════════════════════════════
# utilities
# ═══════════════════════════════════════════════════════════════════════════════

def _active_env() -> str:
    """Resolved by bin/active_env.py — an exported ACTIVE_ENV pins the session and
    wins over .env, so a concurrent session cannot change it mid-task (#126).

    REPO_ROOT is the DATA root and is overridable, so it is passed as an argument
    rather than used to find the module: importing code from a path that a caller
    controls is how a fixture directory ends up shadowing real modules.
    """
    from bin.active_env import resolve
    return resolve(REPO_ROOT)[0]


def _env_path(name: str) -> Path:
    return REPO_ROOT / 'environments' / name


def _env_yml(name: str) -> Path:
    return _env_path(name) / 'env.yml'


def _load_env(name: str) -> dict:
    yml = _env_yml(name)
    if not yml.exists():
        raise FileNotFoundError(f"Environment '{name}' not found at {yml}")
    return yaml.safe_load(yml.read_text())


def _resolve_env(name: str | None) -> str:
    name = name or _active_env()
    if not name:
        print("ERROR: No environment.  Run: opskit env <name>", file=sys.stderr)
        sys.exit(1)
    if not _env_yml(name).exists():
        print(f"ERROR: Environment '{name}' not found.", file=sys.stderr)
        print(f"  Run: opskit env --create {name} --subnets <cidr,...>", file=sys.stderr)
        sys.exit(1)
    return name


def _env_name_collision(name: str) -> Optional[str]:
    """Return an existing environments/ entry matching name case-insensitively."""
    ed = REPO_ROOT / 'environments'
    if not ed.exists():
        return None
    for d in ed.iterdir():
        if d.is_dir() and d.name.lower() == name.lower():
            return d.name
    return None


def _list_envs() -> list[str]:
    ed = REPO_ROOT / 'environments'
    if not ed.exists():
        return []
    return sorted(d.name for d in ed.iterdir() if d.is_dir() and (d / 'env.yml').exists())


# ═══════════════════════════════════════════════════════════════════════════════
# init
# ═══════════════════════════════════════════════════════════════════════════════

ENV_YML_TEMPLATE = """\
# {name} environment — https://github.com/CascadeSTEAM/opskit
# Edit this file to declare subnets, credentials, connectivity probes, etc.

name: {name}
display_name: {display_name}

ticket:
  prefix: {ticket_prefix}
  helpdesk: none

domains:
  primary: {name}.local

subnets:
  primary: {primary_subnet}

connectivity:
  probes:
    - host: {first_gateway}
      description: default gateway

vault:
  backend: none
  collection: {name}

source_of_truth:
  type: git-yaml

execution:
  type: cli

ansible:
  ssh_user: root

referenced_devices: []
cross_env_credentials: []
"""

INVENTORY_TEMPLATE = """\
# Ansible inventory for {name}
# Groups inherited from opskit roles: workstations, network_devices, proxmox_nodes, etc.

all:
  children:
    {name}:
      hosts:
"""

NETWORK_YML_TEMPLATE = """\
# {name} network configuration
network:
  name: {name}
  cidr: {primary_subnet}
  exclude_cidrs: []
"""


def cmd_env_create(args):
    name = args.name
    if not name:
        # Interactive mode
        print("  opskit — scaffold new environment")
        print()
        name = input("  Environment name (slug letters, numbers, hyphens): ").strip().lower()
        if not name:
            print("  Cancelled.", file=sys.stderr)
            sys.exit(1)
        display = input("  Display name (press Enter for default): ").strip()
        subnets = input("  Subnets (CIDRs, comma-separated, e.g. 192.0.2.0/24): ").strip()
        ticket = input("  Ticket prefix (e.g. ACME, or press Enter for auto): ").strip()
        args.display_name = display or None
        args.subnets = subnets or None
        args.ticket_prefix = ticket or None

    dest = _env_path(name)

    existing = _env_name_collision(name)
    if existing and existing != name:
        # A twin differing only by case is a footgun on case-insensitive
        # filesystems and confuses env resolution — refuse outright.
        print(f"ERROR: environments/{existing}/ already exists and differs "
              f"from '{name}' only by case.", file=sys.stderr)
        print(f"  Use the existing environment:  opskit env {existing}", file=sys.stderr)
        print(f"  Or pick a name that is not a case-variant of '{existing}'.", file=sys.stderr)
        sys.exit(1)
    if dest.exists():
        print(f"ERROR: environments/{name}/ already exists.", file=sys.stderr)
        sys.exit(1)

    subnets_raw = args.subnets or "192.0.2.0/24"
    subnets = [s.strip() for s in subnets_raw.split(",")]
    primary = subnets[0]
    first_ip = primary.rsplit(".", 1)[0] + ".1"

    # directories
    for d in [
        dest / "ansible",
        dest / "datasets" / "devices",
        dest / "playbooks",
    ]:
        d.mkdir(parents=True, exist_ok=True)

    # env.yml
    env_yml = ENV_YML_TEMPLATE.format(
        name=name,
        display_name=args.display_name or name.title(),
        ticket_prefix=args.ticket_prefix or name[:4].upper(),
        primary_subnet=primary,
        first_gateway=first_ip,
    )
    (dest / "env.yml").write_text(env_yml)

    # ansible inventory
    (dest / "ansible" / "inventory.yml").write_text(
        INVENTORY_TEMPLATE.format(name=name)
    )

    # network.yml
    (dest / "datasets" / "network.yml").write_text(
        NETWORK_YML_TEMPLATE.format(name=name, primary_subnet=primary)
    )

    print(f"  Created environments/{name}/")
    print(f"    env.yml             — environment config (edit subnets, probes, etc.)")
    print(f"    ansible/inventory.yml — Ansible host inventory")
    print(f"    datasets/devices/    — device records go here (.yml or .md front matter)")
    print(f"    datasets/network.yml — network CIDR config")
    print(f"    playbooks/           — env-specific Ansible playbooks")
    print()
    print(f"  Next: opskit env {name}      # switch to this environment")
    print(f"        opskit scan             # discover devices on the network")


# ═══════════════════════════════════════════════════════════════════════════════
# scan  (full pipeline)
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_scan(args):
    from bin.scanner_lib import nmap_runner, parser, dataset_writer, scaffold, enricher
    from bin.device_registry import DeviceRegistry

    env = _resolve_env(args.env)
    config = _load_env(env)
    subnets = list(config.get('subnets', {}).values())

    if not subnets:
        print(f"  No subnets in environments/{env}/env.yml")
        return

    ds_dir = _env_path(env) / 'datasets'
    print(f"  Environment: {config.get('display_name', env)} ({env})")
    print(f"  Subnets: {', '.join(subnets)}")

    # ── Phase 1: Discover ─────────────────────────────────────────────────────

    if args.fixture:
        print(f"  Mode: fixture ({args.fixture})")
        hosts = parser.parse_portscan(args.fixture)
    elif args.enrich_only or args.uplinks_only:
        hosts = []
        print("  Skipping nmap scan (--enrich-only / --uplinks-only)")
    else:
        print("  Mode: live nmap scan")

        # Local subnets scanned without root silently lose ARP-level data
        # (empty MACs, no vendor) — warn loudly instead (#141).
        warning = nmap_runner.unprivileged_scan_warning(
            subnets, nmap_runner.is_privileged(), args.sudo)
        if warning:
            print(warning)

        if args.dry_run:
            print("  [DRY RUN] Would scan: " + " ".join(subnets))
            return

        # Cache sudo credentials up front so the password prompt happens
        # once here, not mid-scan inside a captured-output nmap run.
        if args.sudo and not nmap_runner.is_privileged():
            if subprocess.run(['sudo', '-v']).returncode != 0:
                print("  ERROR: --sudo requested but sudo authentication failed")
                return

        # Run discovery on each subnet
        discovery_hosts = []
        for subnet in subnets:
            xml_path = nmap_runner.discover(subnet, use_sudo=args.sudo,
                                            timeout=args.timeout)
            if xml_path:
                discovery_hosts.extend(parser.parse_discovery(xml_path))

        if not discovery_hosts:
            print("  ERROR: nmap discovery found no hosts")
            return

        hosts = discovery_hosts
        if not args.discover_only:
            live_ips = [h['ip'] for h in hosts if h.get('status') == 'up']
            if live_ips:
                portscan_xml = nmap_runner.portscan(live_ips, use_sudo=args.sudo)
                if portscan_xml:
                    hosts = parser.parse_portscan(portscan_xml, hosts)

    print(f"  Phase 1 — discovered {len(hosts)} hosts")

    if args.discover_only:
        for h in sorted(hosts, key=lambda x: x.get('ip', '')):
            print(f"    {h.get('ip','?'):15s}  {h.get('mac','?'):17s}  {h.get('hostname','?')}")
        return

    # ── Phase 2: Write YAMLs ───────────────────────────────────────────────────

    devices_dir = ds_dir / 'devices'
    devices_dir.mkdir(parents=True, exist_ok=True)
    dataset_writer.write_devices(hosts, ds_dir, env)
    yml_count = len(list(devices_dir.glob('*.yml')))
    print(f"  Phase 2 — wrote {yml_count} device YAMLs to {devices_dir}")

    # ── Phase 3: Enrich ────────────────────────────────────────────────────────

    if not args.skip_enrich:
        enricher.enrich_dataset(ds_dir)
        print(f"  Phase 3 — enriched: dedup, parent-child, infrastructure links")

    # ── Phase 4: Resolve uplinks ───────────────────────────────────────────────

    if not args.skip_uplinks:
        router = config.get('topology', {}).get('router') or 'router'
        reg = DeviceRegistry(router_hostname=router)

        for yf in sorted(devices_dir.glob('*.yml')):
            try:
                data = yaml.safe_load(yf.read_text()) or {}
                dev = data.get('device', data)
                macs = dev.get('mac_address') or ''
                if isinstance(macs, list):
                    macs = macs[0] if macs else ''
                record = {
                    'mac': macs,
                    'ip': dev.get('ip_address') or '',
                    'hostname': dev.get('hostname') or dev.get('name') or yf.stem,
                    'type': dev.get('role') or 'unknown',
                    'role': dev.get('role') or 'unknown',
                    'os': dev.get('os') or '',
                    'status': dev.get('status') or 'unknown',
                }
                reg.register(record, 'nmap')
            except Exception:
                pass

        reg.merge_identities()

        # Bridge table + LLDP (if router reachable via SSH)
        if not args.no_router:
            _resolve_topology_from_router(reg, config, env)

        reg.resolve_uplinks()
        problems = reg.validate()
        reg.audit()

        if problems:
            print(f"\n  • {len(problems)} topology problems (see above)")

        # Write uplinks back to YAML
        y_upd, y_skip = reg.write_uplinks_to_yaml(devices_dir)
        if y_upd:
            print(f"  Phase 4 — uplink_host written to {y_upd} YAMLs ({y_skip} skipped)")

    print(f"\n  Done.  devices: {devices_dir}")


def _resolve_topology_from_router(reg, config: dict, env: str):
    """Attempt to pull bridge table + LLDP from the env's router."""
    attempt = config.get('topology', {}).get('router_ssh')
    if not attempt:
        return
    try:
        bridge_raw = subprocess.check_output(
            ['ssh', '-o', 'ConnectTimeout=5', attempt,
             '/interface bridge host print terse without-paging'],
            text=True, stderr=subprocess.DEVNULL, timeout=10,
        )
        lldp_raw = subprocess.check_output(
            ['ssh', '-o', 'ConnectTimeout=5', attempt,
             '/ip neighbor print terse without-paging'],
            text=True, stderr=subprocess.DEVNULL, timeout=10,
        )
        bridge_table, lldp_neighbors = _parse_bridge_lldp(bridge_raw, lldp_raw)
        reg.set_topology(bridge_table, lldp_neighbors)
        print(f"  Phase 4 — topology resolved from router via SSH")
    except Exception as e:
        print(f"  Phase 4 — router unreachable ({e}), skipping topology resolution")


def _parse_bridge_lldp(bridge_raw: str, lldp_raw: str):
    import re
    bridge_table = {}
    for line in bridge_raw.splitlines():
        m = re.search(r'mac-address=([^ ]+)', line)
        intf = re.search(r'interface=([^ ]+)', line)
        if m and intf:
            bridge_table[m.group(1)] = intf.group(1)

    lldp_neighbors = {}
    for line in lldp_raw.splitlines():
        intf = re.search(r'interface-name=([^ ]+)', line)
        sysn = re.search(r'system-name=([^ ]+)', line)
        if intf and sysn:
            lldp_neighbors[intf.group(1)] = sysn.group(1)

    return bridge_table, lldp_neighbors


# ═══════════════════════════════════════════════════════════════════════════════
# status
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_status(args):
    env = _resolve_env(args.env)
    config = _load_env(env)
    devices_dir = _env_path(env) / 'datasets' / 'devices'

    print(f"  Environment: {config.get('display_name', env)} ({env})")
    print(f"  Subnets: {', '.join(config.get('subnets', {}).values())}")

    if devices_dir.exists():
        ymls = list(devices_dir.glob('*.yml'))
        print(f"  Devices: {len(ymls)} YAML files")

        roles: dict[str, int] = {}
        for yf in ymls:
            try:
                data = yaml.safe_load(yf.read_text()) or {}
                dev = data.get('device', data)
                role = dev.get('role') or dev.get('type') or 'unknown'
                roles[role] = roles.get(role, 0) + 1
            except Exception:
                roles['error'] = roles.get('error', 0) + 1

        for role, count in sorted(roles.items()):
            print(f"    {role:20s} {count}")
    else:
        print(f"  Devices: none — run 'opskit scan' first")


# ═══════════════════════════════════════════════════════════════════════════════
# env
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_env(args):
    if args.list:
        for e in _list_envs():
            print(e)
        return

    if args.create:
        cmd_env_create(args)
        return

    if args.name:
        env_yml = _env_yml(args.name)
        if env_yml.exists():
            result = subprocess.run(
                ['bash', str(SCRIPT_DIR / 'switch-env.sh'), args.name],
                cwd=str(REPO_ROOT),
            )
            sys.exit(result.returncode)
        # Environment doesn't exist — offer to scaffold it
        print(f"  Environment '{args.name}' does not exist.")
        print()
        print(f"  Options:")
        print(f"    opskit env --create {args.name} --subnets 192.0.2.0/24  # scaffold now")
        print(f"    opskit env --create                                    # interactive scaffold")
        if _list_envs():
            print(f"\n  Existing environments:")
            for e in _list_envs():
                try:
                    cfg = _load_env(e)
                    print(f"    {e:20s}  {cfg.get('display_name', '')}")
                except Exception:
                    print(f"    {e:20s}")
        else:
            print("\n  No environments yet — run: opskit env --create")
        sys.exit(1)

    current = _active_env()
    if current:
        config = _load_env(current)
        print(f"  Active: {config.get('display_name', current)} ({current})")
        print(f"  Subnets: {', '.join(config.get('subnets', {}).values())}")
    else:
        print("  No active environment.")
    envs = _list_envs()
    if envs:
        print(f"\n  Available environments ({len(envs)}):")
        for e in envs:
            try:
                cfg = _load_env(e)
                print(f"    {e:20s}  {cfg.get('display_name', '')}")
            except Exception:
                print(f"    {e:20s}")

    if not current:
        print("\n  Run: opskit env --create <name>  to create an environment")
        print(f"  Then: opskit env <name>       to switch")


# ═══════════════════════════════════════════════════════════════════════════════
# lint
# ═══════════════════════════════════════════════════════════════════════════════

def _inventory_hosts(node) -> set[str]:
    """Recursively collect host names from an Ansible YAML inventory tree."""
    found: set[str] = set()
    if not isinstance(node, dict):
        return found
    for key, val in node.items():
        if key == 'hosts' and isinstance(val, dict):
            found.update(val.keys())
        elif isinstance(val, dict):
            found.update(_inventory_hosts(val))
    return found


def cmd_lint(args):
    env = _resolve_env(args.env)
    env_dir = _env_path(env)
    inventory_file = env_dir / 'ansible' / 'inventory.yml'
    devices_dir = env_dir / 'datasets' / 'devices'

    print(f"  Linting environment: {env}")

    if not inventory_file.exists():
        print(f"  \033[0;31m✗\033[0m no inventory at environments/{env}/ansible/inventory.yml",
              file=sys.stderr)
        sys.exit(1)

    inventory = yaml.safe_load(inventory_file.read_text()) or {}
    hosts = _inventory_hosts(inventory)

    # Accept every extension a device record can legitimately have. The old code
    # globbed '*.yml' only, while env.yml declares the real one via
    # source_of_truth.format — so for a layer storing devices as .md with YAML
    # front matter the set came back empty, every inventory host was reported
    # missing, and lint exited 1. It had never passed there, and a check whose
    # output is always wrong is worse than no check: it teaches people to ignore
    # the output (opskit #114, ledger row 23).
    #
    # Both extensions are accepted regardless of what is declared. The declared
    # format says what the layer is converging on; failing a half-migrated layer
    # for containing both would break the check exactly when it is most useful.
    device_yamls = set()
    if devices_dir.exists():
        for pattern in ('*.yml', '*.yaml', '*.md'):
            device_yamls |= {p.stem for p in devices_dir.glob(pattern)}

    missing = sorted(hosts - device_yamls)
    orphans = sorted(device_yamls - hosts)

    for host in missing:
        print(f"  \033[0;31m✗\033[0m {host}: in inventory but no datasets/devices/{host}.{{yml,yaml,md}}")
    for name in orphans:
        print(f"  \033[1;33m⚠\033[0m {name}: datasets/devices/{name}.* has no inventory host")

    covered = len(hosts) - len(missing)
    print(f"\n  {covered}/{len(hosts)} inventory hosts have a device record"
          f"; {len(orphans)} orphan device record(s)")
    if missing:
        sys.exit(1)


# ═══════════════════════════════════════════════════════════════════════════════
# init (OpsKit-aware member scaffold)
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_init(args):
    target = Path(args.path or ".").resolve()
    extra: list[str] = []
    if args.name:
        extra += ['--name', args.name]
    if args.classification:
        extra += ['--classification', args.classification]
    if args.sync:
        extra += ['--sync', args.sync]
    if args.force:
        extra.append('--force')
    result = subprocess.run(
        [sys.executable, str(SCRIPT_DIR / 'opskit-aware.py'), 'init', str(target)]
        + extra,
        cwd=str(target),
        env={**os.environ, 'OPSKIT_ROOT': str(REPO_ROOT)},
        capture_output=True,
        text=True,
    )
    print(result.stdout, end='')
    if result.stderr:
        print(result.stderr, file=sys.stderr, end='')
    if result.returncode != 0:
        sys.exit(result.returncode)

    # Parse the init output to get the member name
    try:
        init_data = json.loads(result.stdout)
    except (json.JSONDecodeError, ValueError):
        sys.exit(0)
    member_name = init_data.get('name', target.name)

    # Step 2: Add to .project-remotes if not already present
    remotes_file = REPO_ROOT / '.project-remotes'
    entry = f'{member_name} {target}'
    already_present = False
    remotes_content = remotes_file.read_text() if remotes_file.is_file() else ''
    for line in remotes_content.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith('#'):
            parts = stripped.split()
            if len(parts) >= 2 and parts[0] == member_name:
                already_present = True
                break
    if not already_present:
        with open(remotes_file, 'a') as f:
            if remotes_content.strip():
                f.write('\n')
            f.write(entry + '\n')
        print(f'Added {member_name} to .project-remotes', file=sys.stderr)

    # Step 3: Run sync-mount to create symlinks and render agents/skills
    # Skip if:
    #   - the target is inside the OpsKit repo itself (members live under
    #     projects/ or are the repo root), OR
    #   - --no-sync-mount was passed (used by tests to avoid modifying the
    #     repo's .opencode/skills/ and .claude/skills/).
    # Running sync-mount against the OpsKit repo would modify .opencode/skills/
    # and .claude/skills/, which breaks test_skill_tree_divergence.
    _projects = REPO_ROOT / "projects"
    _inside_opskit = (
        target == REPO_ROOT
        or str(target.resolve()).startswith(str(_projects.resolve()))
    )
    _skip_sync = args.no_sync_mount or _inside_opskit
    if not _skip_sync:
        sync_result = subprocess.run(
            [sys.executable, str(SCRIPT_DIR / 'project_sync.py'), 'sync-mount'],
            cwd=str(REPO_ROOT),
            env={**os.environ, 'OPSKIT_ROOT': str(REPO_ROOT)},
            capture_output=True,
            text=True,
        )
        print(sync_result.stdout, end='', file=sys.stderr)
        if sync_result.stderr:
            print(sync_result.stderr, file=sys.stderr, end='')
        if sync_result.returncode != 0:
            sys.exit(sync_result.returncode)


# ═══════════════════════════════════════════════════════════════════════════════
# member — manage OpsKit member projects (sync/mount/status)
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_member(args):
    """Dispatch member subcommands to project_sync.py."""
    subcmd = args.member_command
    if not subcmd:
        print('usage: opskit member <status|sync|mount|sync-mount|prune>', file=sys.stderr)
        sys.exit(1)

    valid = ('status', 'sync', 'mount', 'sync-mount', 'prune')
    if subcmd not in valid:
        print(f'error: unknown member subcommand {subcmd!r} (choose from: {", ".join(valid)})',
              file=sys.stderr)
        sys.exit(1)

    result = subprocess.run(
        [sys.executable, str(SCRIPT_DIR / 'project_sync.py'), subcmd],
        cwd=str(REPO_ROOT),
        env={**os.environ, 'OPSKIT_ROOT': str(REPO_ROOT)},
        capture_output=True,
        text=True,
    )
    print(result.stdout, end='')
    if result.stderr:
        print(result.stderr, file=sys.stderr, end='')
    sys.exit(result.returncode)


# ═══════════════════════════════════════════════════════════════════════════════
# setup-completion
# ═══════════════════════════════════════════════════════════════════════════════

COMPLETION_SCRIPT = """\
# opskit completion — installed by 'opskit setup-completion'
_opskit_completion() {{
    local cur prev words cword
    _init_completion || return
    COMPREPLY=()

    case "${{words[1]}}" in
        env)
            COMPREPLY=( $(compgen -W "create" -- "$cur") )
            ;;
        init)
            COMPREPLY=( $(compgen -W "" -- "$cur") )
            ;;
        member)
            COMPREPLY=( $(compgen -W "status sync mount sync-mount prune" -- "$cur") )
            ;;
        scan|status|lint)
            COMPREPLY=( $(compgen -W "--env --dry-run --discover-only --enrich-only --uplinks-only --skip-enrich --skip-uplinks --no-router --fixture --sudo" -- "$cur") )
            ;;
        setup-completion)
            COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") )
            ;;
        *)
            COMPREPLY=( $(compgen -W "env init member scan status lint setup-completion" -- "$cur") )
            ;;
    esac
}}
complete -F _opskit_completion opskit
"""

COMPLETION_ZSH = r"""\
#compdef opskit
_opskit() {{
    local -a commands
    commands=(env:'show or switch active environment (use --create to scaffold)'
              init:'scaffold OpsKit member manifest'
              member:'manage member projects (sync/mount/status)'
              scan:'full network scan'
              status:'inventory summary'
              lint:'inventory vs device record check'
              setup-completion:'install tab completion')
    _describe 'command' commands
    _arguments '--env[environment name]:env:'
}}
compdef _opskit opskit
"""


def cmd_completion(args):
    shell = args.shell or 'bash'
    if shell == 'bash':
        dest = Path.home() / '.bash_completion.d' / 'opskit'
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(COMPLETION_SCRIPT)
        print(f"  Installed bash completion to {dest}")
        print(f"  Add to ~/.bashrc:  source {dest}")
    elif shell == 'zsh':
        dest = Path.home() / '.zsh' / 'completions' / '_opskit'
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(COMPLETION_ZSH)
        print(f"  Installed zsh completion to {dest}")
        print(f"  Ensure ~/.zsh/completions/ is in your fpath")
    else:
        print(f"  Unknown shell: {shell}", file=sys.stderr)
        sys.exit(1)


# ═══════════════════════════════════════════════════════════════════════════════
# check
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_check(args):
    from shutil import which

    all_ok = True

    def ok(msg: str):
        print(f"  \033[0;32m✓\033[0m {msg}")

    def warn(msg: str):
        nonlocal all_ok
        all_ok = False
        print(f"  \033[1;33m⚠\033[0m {msg}")

    def fail(msg: str):
        nonlocal all_ok
        all_ok = False
        print(f"  \033[0;31m✗\033[0m {msg}")

    # System tools
    for cmd, pkg in [('python3', 'python3'), ('nmap', 'nmap'), ('ansible-playbook', 'ansible')]:
        if which(cmd):
            ok(f"{cmd:25s}  {which(cmd)}")
        else:
            fail(f"{cmd:25s}  not found  (apt install {pkg})")

    # Python packages
    for pkg in ['yaml', 'jsonschema']:
        try:
            __import__(pkg)
            ok(f"python3 {pkg}".ljust(27) + "installed")
        except ImportError:
            warn(f"python3 {pkg}".ljust(27) + f"not installed  (pip install {pkg})")

    # Git hooks
    hooks_ok = subprocess.run(
        ['git', 'config', 'core.hooksPath'],
        cwd=str(REPO_ROOT), capture_output=True, text=True
    ).stdout.strip()
    if '.githooks' in hooks_ok:
        ok("git hooks".ljust(27) + f"→ {hooks_ok}")
    else:
        ok("git hooks".ljust(27) + "→ .githooks (set in local config)")

    # Environments
    envs = _list_envs()
    if envs:
        ok(f"environments ({len(envs)})".ljust(27) + ", ".join(envs[:5]))
        if len(envs) > 5:
            print("  " + " " * 28 + f"... and {len(envs) - 5} more")
    else:
        warn("no environments found (run: opskit env --create <name>)")

    # Active env
    active = _active_env()
    if active:
        ok(f"active environment".ljust(27) + active)
    else:
        warn("no active environment (run: opskit env <name>)")

    # Install check
    if which('opskit'):
        ok("opskit in PATH".ljust(27) + which('opskit'))
    else:
        warn("opskit not in PATH — run: bash install.sh")

    print()
    if all_ok:
        print("  All checks passed.")
    else:
        print("  Some checks failed — see above for fix instructions.")
        sys.exit(1)


# ═══════════════════════════════════════════════════════════════════════════════
# setup (pip deps, git hooks)
# ═══════════════════════════════════════════════════════════════════════════════

def cmd_setup(args):
    failed = False

    for pkg in ['pyyaml', 'jsonschema']:
        # Check if already installed first
        try:
            __import__(pkg if pkg != 'pyyaml' else 'yaml')
            print(f"  \033[0;32m✓\033[0m python3 {pkg} already installed")
            continue
        except ImportError:
            pass
        result = subprocess.run(
            [sys.executable, '-m', 'pip', 'install', '--quiet', '--user', pkg],
            capture_output=True, text=True,
        )
        if result.returncode == 0:
            print(f"  \033[0;32m✓\033[0m pip install {pkg}")
        else:
            print(f"  \033[0;31m✗\033[0m pip install {pkg} failed: {result.stderr.strip()[:80]}")
            failed = True

    result = subprocess.run(
        ['git', 'config', 'core.hooksPath', '.githooks'],
        cwd=str(REPO_ROOT), capture_output=True, text=True,
    )
    if result.returncode == 0:
        print(f"  \033[0;32m✓\033[0m git hooks → .githooks")
    else:
        print(f"  \033[1;33m⚠\033[0m git hooks config failed — run manually")

    print()
    if not failed:
        print("  Setup complete.  Run: opskit check")
    else:
        sys.exit(1)


# ═══════════════════════════════════════════════════════════════════════════════
# idea — capture an idea to the local ledger
# ═══════════════════════════════════════════════════════════════════════════════

def resolve_idea_target(args) -> tuple[Path, str]:
    """Resolve the ledger path and project name for idea capture.

    Returns (ledger_path, project_label) where:
      - ledger_path is the absolute path to the ideas.md file
      - project_label is a human-readable name for display (e.g. "opskit", "/path/to/project")
    """
    from pathlib import Path as P

    # Explicit --ledger wins
    if args.ledger:
        ledger_path = P(args.ledger).resolve()
        project_label = args.ledger
        return ledger_path, project_label

    # Explicit --project: resolve as path or known name
    if args.project:
        proj = P(args.project)
        if proj.exists() and (proj / ".opskit" / "pack.yml").exists():
            # opskit-aware project
            ledger = proj / "docs" / "ideas.md"
            return ledger, str(proj)
        if (proj / "docs" / "ideas.md").exists():
            return proj / "docs" / "ideas.md", str(proj)
        # Maybe it's a known project name — check environments/
        env_path = REPO_ROOT / "environments" / args.project
        if env_path.exists():
            # It's an env name — use opskit ledger
            return REPO_ROOT / "docs" / "ideas.md", "opskit"
        # Treat as path
        if proj.is_dir():
            ledger = proj / "docs" / "ideas.md"
            return ledger, str(proj)

    # Auto-detect: resolve the actual git repo root (handles worktrees)
    cwd = P.cwd().resolve()
    git_root = None

    # For worktrees, git rev-parse --show-toplevel returns the worktree path,
    # not the main checkout. We detect worktrees and resolve to the main repo.
    dot_git = P.cwd() / ".git"
    actual_root = None
    if dot_git.is_file():
        # Worktree: .git is a file pointing to the real git dir
        try:
            content = dot_git.read_text().strip()
            m = re.match(r"gitdir: (.+)", content)
            if m:
                gitdir = Path(m.group(1))
                # Main repo .git dir is at: <git-common-dir> or <gitdir>/../../
                # gitdir paths look like: /main/.git/worktrees/<wt-name>
                # The main .git is the parent of the 'worktrees' directory
                if "worktrees" in gitdir.parts:
                    parts = gitdir.parts
                    idx = parts.index("worktrees")
                    # idx-1 is the worktree name, idx-2 is .git
                    if idx >= 2:
                        actual_root = P("/").joinpath(*parts[:idx-1])
        except (OSError, ValueError):
            pass

    if actual_root:
        # Inside a worktree — check if it's opskit or opskit-aware
        if actual_root == REPO_ROOT:
            return actual_root / "docs" / "ideas.md", actual_root.name or str(actual_root)
        if (actual_root / ".opskit" / "pack.yml").exists():
            return actual_root / "docs" / "ideas.md", str(actual_root)

    if not git_root:
        try:
            out = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                capture_output=True, text=True, check=True, timeout=5,
            )
            git_root = Path(out.stdout.strip()).resolve()
        except (subprocess.CalledProcessError, FileNotFoundError, OSError):
            pass

    if git_root and git_root != actual_root:
        # Inside a git repo — check if it's opskit or opskit-aware
        if git_root == REPO_ROOT or REPO_ROOT in (git_root.parents or []):
            return git_root / "docs" / "ideas.md", git_root.name if git_root.name else str(git_root)
        if (git_root / ".opskit" / "pack.yml").exists():
            return git_root / "docs" / "ideas.md", str(git_root)

    # Fallback: prompt
    print(f"Could not auto-detect a project from {cwd}.")
    print(f"Use --project <name-or-path> or --ledger <path-to-ideas.md>")
    print(f"For now, defaulting to: {REPO_ROOT / 'docs' / 'ideas.md'}")
    return REPO_ROOT / "docs" / "ideas.md", "opskit (fallback)"


def _ensure_ledger(ledger_path: Path, project_label: str) -> None:
    """Create docs/ideas.md with a minimal table header if it doesn't exist."""
    if ledger_path.exists():
        return
    ledger_path.parent.mkdir(parents=True, exist_ok=True)
    header = (
        "# Idea Ledger\n"
        "\n"
        "Raw enhancement/tooling ideas land here first — not as individual GitHub\n"
        "issues. Manage this table with `python3 <opskit-root>/bin/idea.py`.\n"
        "\n"
        "| Date | Desire (1-5) | Title | Description | Status | GH# |\n"
        "|------|--------------|-------|-------------|--------|-----|\n"
    )
    ledger_path.write_text(header)
    # Stage it in git
    try:
        subprocess.run(
            ["git", "add", str(ledger_path)],
            cwd=Path(ledger_path).parent.parent,
            capture_output=True, check=True, timeout=10,
        )
    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
        pass


def _prompt(label: str) -> str:
    """Read a line from stdin."""
    sys.stdout.write(label)
    sys.stdout.flush()
    try:
        return input()
    except EOFError:
        return ""


def cmd_idea_handler(args) -> None:
    """Handle the `opskit idea` subcommand."""
    ledger_path, project_label = resolve_idea_target(args)

    # Ensure ledger exists (create minimal one if needed)
    _ensure_ledger(ledger_path, project_label)

    # Get idea text
    if args.text:
        text = args.text
    else:
        print(f"Capturing idea for {project_label} ({ledger_path})")
        text = _prompt("What's your idea? ")
    if not text.strip():
        print("ERROR: no idea provided", file=sys.stderr)
        sys.exit(1)

    # Determine repo root for idea-cmd.py (ledger's parent.parent)
    ledger_repo_root = ledger_path.parent.parent

    # Get desire level
    if args.desire is None:
        desire_str = _prompt("Importance (1-5, default 3): ")
        try:
            desire = int(desire_str.strip()) if desire_str.strip() else 3
            if desire < 1:
                desire = 1
            if desire > 5:
                desire = 5
        except ValueError:
            desire = 3
    else:
        desire = args.desire

    # Title from first sentence or first 80 chars of text
    title_text = text.strip()
    title = title_text[:80] + ("..." if len(title_text) > 80 else "")

    # Run dedupe check
    dedupe_script = SCRIPT_DIR / "idea-cmd.py"
    try:
        dedupe_result = subprocess.run(
            [sys.executable, str(dedupe_script), "--file", str(ledger_path),
             "dedupe", title, "--gh"],
            capture_output=True, text=True, timeout=30,
        )
        if dedupe_result.returncode == 0:
            dedupe_data = json.loads(dedupe_result.stdout)
            if dedupe_data.get("count", 0) > 0:
                print(f"\nPotential duplicates found ({dedupe_data['count']}):")
                for m in dedupe_data["matches"]:
                    if m.get("type") == "ledger":
                        print(f"  Ledger row {m['row']}: \"{m['title']}\" "
                              f"(status: {m['status']}, desire: {m['desire']})")
                    else:
                        print(f"  GH #{m['number']}: \"{m['title']}\" "
                              f"({m['state']}) — {m['url']}")
                confirm = _prompt("\nCreate a new idea anyway? (y/n): ")
                if confirm.strip().lower() not in ("y", "yes"):
                    print("Cancelled.")
                    return
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError):
        pass  # dedupe failed silently, proceed with capture

    # Capture: add to ledger via bin/idea.py
    # First, run idea-cmd.py capture to get structured JSON
    try:
        capture_result = subprocess.run(
            [sys.executable, str(dedupe_script), "--file", str(ledger_path),
             "capture", "--title", title, "--desc", text.strip()],
            capture_output=True, text=True, timeout=10,
        )
        if capture_result.returncode == 0:
            captured = json.loads(capture_result.stdout)
            # Now use idea.py to actually add the row
            idea_script = SCRIPT_DIR / "idea.py"
            add_result = subprocess.run(
                [sys.executable, str(idea_script), "--file", str(ledger_path),
                 "add", "--desire", str(desire),
                 "--title", captured["title"],
                 "--desc", captured["description"]],
                capture_output=True, text=True, timeout=10,
            )
            if add_result.returncode == 0:
                print(f"\n✓ Added to {project_label} ledger: {captured['title']} (desire: {desire})")
                print(f"  Ledger: {ledger_path}")
                # Suggest next steps
                print(f"\n  Next steps:")
                print(f"    Run:   opskit idea  # to capture another idea")
                print(f"    Or:    bin/idea.py list  # view all ideas")
                return
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError) as e:
        print(f"ERROR: failed to capture idea: {e}", file=sys.stderr)

    # Fallback: direct idea.py call
    idea_script = SCRIPT_DIR / "idea.py"
    add_result = subprocess.run(
        [sys.executable, str(idea_script), "--file", str(ledger_path),
         "add", "--desire", str(desire),
         "--title", title,
         "--desc", text.strip()],
        capture_output=True, text=True, timeout=10,
    )
    if add_result.returncode == 0:
        print(f"\n✓ Added to {project_label} ledger: {title} (desire: {desire})")
    else:
        print(f"ERROR: {add_result.stderr}", file=sys.stderr)
        sys.exit(1)


# ═══════════════════════════════════════════════════════════════════════════════
# main
# ═══════════════════════════════════════════════════════════════════════════════

def main():
    p = argparse.ArgumentParser(
        description="opskit — network operations toolkit",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  opskit check                                    verify everything is ready
  opskit env --create homelab --subnets 192.0.2.0/24  scaffold a new environment
  opskit env homelab                              switch to environment
  opskit init                                     scaffold OpsKit member manifest
  opskit member status                            show member mount state
  opskit member sync                              clone/pull members + symlinks
  opskit member mount                             validate + render agents/skills
  opskit member sync-mount                        sync + mount in one step
  opskit member prune                             remove stale rendered items
  opskit scan                                     discover + enrich + resolve
  opskit scan --dry-run                           preview without touching network
  opskit status                                   inventory summary
  opskit lint                                     flag inventory hosts missing device YAML
  opskit setup                                    install python deps + hooks
  opskit idea "add a dark mode"                   capture an idea to the local ledger
  opskit idea --desire 5 "fix auth bug"           capture with explicit importance

  opskit also works without the install:
    python3 bin/opskit ...

Semaphore (optional web UI for Ansible): set execution.type: semaphore in
env.yml and run  bin/semaphore-sync.py  to publish your playbook catalogue.
Without Semaphore, playbooks run via the CLI with  bin/ap.sh <playbook>.
        """,
    )
    sub = p.add_subparsers(dest='command')

    # check
    pk = sub.add_parser('check', help='verify dependencies and environment')

    # setup
    pu = sub.add_parser('setup', help='install python dependencies + git hooks')

    # init — scaffold OpsKit member manifest in a project
    pi = sub.add_parser('init', help='scaffold .opskit/ member manifest')
    pi.add_argument('path', nargs='?', default='.', help='target directory (default: cwd)')
    pi.add_argument('--name', help='member name (default: slug of dir name)')
    pi.add_argument('--classification', default='public',
                    choices=['public', 'internal', 'client'],
                    help='data classification for the member')
    pi.add_argument('--sync', default='symlink',
                    choices=['clone', 'symlink'],
                    help='how OpsKit syncs the member')
    pi.add_argument('--force', action='store_true', help='overwrite existing .opskit/ (backs up)')
    pi.add_argument('--no-sync-mount', action='store_true',
                    help='skip automatic sync-mount after init')

    # member — manage OpsKit member projects
    pm = sub.add_parser('member', help='manage member projects (sync/mount/status)')
    pm.add_argument('member_command', nargs='?',
                    choices=['status', 'sync', 'mount', 'sync-mount', 'prune'],
                    help='member subcommand')

    # scan
    ps = sub.add_parser('scan', help='full network scan pipeline')
    ps.add_argument('--env', help='environment name (default: ACTIVE_ENV)')
    ps.add_argument('--dry-run', action='store_true', help='show what would be scanned')
    ps.add_argument('--discover-only', action='store_true', help='nmap discovery only, no YAML write')
    ps.add_argument('--enrich-only', action='store_true', help='re-run enrichment on existing data')
    ps.add_argument('--uplinks-only', action='store_true', help='only resolve uplink topology')
    ps.add_argument('--skip-enrich', action='store_true', help='skip dedup/normalization phase')
    ps.add_argument('--skip-uplinks', action='store_true', help='skip topology resolution')
    ps.add_argument('--no-router', action='store_true', help='skip router SSH for bridge/LLDP')
    ps.add_argument('--fixture', help='nmap XML fixture path (CI/test)')
    ps.add_argument('--timeout', type=int, default=0, help='scan timeout in seconds (0=auto, /24→60s, /16→300s)')
    ps.add_argument('--sudo', action='store_true',
                    help='run nmap via sudo (required for MAC/vendor data on local subnets)')

    # status
    pt = sub.add_parser('status', help='inventory summary')
    pt.add_argument('--env', help='environment name (default: ACTIVE_ENV)')

    # lint
    pl = sub.add_parser('lint', help='check inventory hosts against device YAMLs')
    pl.add_argument('--env', help='environment name (default: ACTIVE_ENV)')

    # env — show/switch environment; env --create scaffolds a new one
    pe = sub.add_parser('env', help='show or switch active environment')
    pe.add_argument('name', nargs='?', help='environment name to switch to')
    pe.add_argument('--list', action='store_true', help='list environment names only')
    pe.add_argument('--create', action='store_true',
                    help='scaffold a new environment (use name arg or prompt)')
    # env --create shares the same sub-options as the old 'init'
    pe.add_argument('--display-name', help='human-readable name (for create)')
    pe.add_argument('--subnets', help='comma-separated CIDR ranges (e.g. "192.0.2.0/24", for create)')
    pe.add_argument('--ticket-prefix', help='helpdesk ticket prefix (e.g. "ACME", for create)')

    # setup-completion
    pc = sub.add_parser('setup-completion', help='install tab completion')
    pc.add_argument('shell', nargs='?', default='bash', choices=['bash', 'zsh'],
                    help='shell (bash or zsh)')

    # idea — capture an idea to the local ledger
    pi = sub.add_parser('idea', help='capture an idea to the local idea ledger')
    pi.add_argument('text', nargs='?', default=None,
                    help='the idea (prompts if omitted)')
    pi.add_argument('--desire', type=int, choices=range(1, 6), default=None,
                    help='importance 1-5 (prompts if omitted)')
    pi.add_argument('--project', default=None,
                    help='project name or path (default: auto-detect from PWD)')
    pi.add_argument('--ledger', default=None,
                    help='explicit path to ideas.md ledger file (overrides --project)')
    pi.set_defaults(func=cmd_idea_handler)

    args = p.parse_args()

    if args.command == 'init':
        cmd_init(args)
    elif args.command == 'scan':
        cmd_scan(args)
    elif args.command == 'status':
        cmd_status(args)
    elif args.command == 'lint':
        cmd_lint(args)
    elif args.command == 'env':
        if getattr(args, 'create', False):
            cmd_env_create(args)
        else:
            cmd_env(args)
    elif args.command == 'check':
        cmd_check(args)
    elif args.command == 'setup':
        cmd_setup(args)
    elif args.command == 'setup-completion':
        cmd_completion(args)
    elif args.command == 'idea':
        cmd_idea_handler(args)
    elif args.command == 'member':
        cmd_member(args)
    else:
        p.print_help()


if __name__ == '__main__':
    main()

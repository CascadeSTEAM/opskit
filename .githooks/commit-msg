#!/bin/bash
# opskit commit-msg hook — validate ticket reference from env.yml
# Reads environments/$ACTIVE_ENV/env.yml for the expected ticket prefix.
set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Client-token guard — commit messages are published; shared logic lives in
# bin/publication-guard.sh so local hooks and CI cannot drift.
bash bin/publication-guard.sh --message-file "$COMMIT_MSG_FILE"

# Resolve ACTIVE_ENV through the shared resolver, so an exported ACTIVE_ENV pins
# this session (opskit #126). This hook is the one that misfired: a concurrent
# session flipped .env and a commit was checked against the wrong environment's
# ticket prefix.
ACTIVE_ENV=$(python3 bin/active_env.py 2>/dev/null || true)

# Only enforce if we can resolve an environment and it has a ticket prefix
if [ -z "$ACTIVE_ENV" ]; then
    exit 0
fi

ENV_YML="environments/$ACTIVE_ENV/env.yml"
if [ ! -f "$ENV_YML" ]; then
    exit 0
fi

PREFIX=$(python3 -c "
import yaml
d = yaml.safe_load(open('$ENV_YML'))
print(d.get('ticket', {}).get('prefix', ''))
" 2>/dev/null)

if [ -z "$PREFIX" ]; then
    exit 0
fi

# Ticket enforcement applies to client-operation sessions, which always have an
# open ticket. Tool development with no open ticket is exempt — the client-token
# guard above still applies.
#
# Resolved through bin/active_ticket.py, not by reading .current-ticket: an
# exported OPSKIT_TICKET pins a session, so a concurrent `switch-env.sh` clearing
# the shared file can no longer make this hook exempt work that should carry a
# ticket (#158). Same precedence as ACTIVE_ENV above.
if ! ACTIVE_TICKET=$(python3 bin/active_ticket.py 2>/dev/null); then
    exit 0
fi
if [ -z "$ACTIVE_TICKET" ]; then
    exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any staged file is infrastructure work (ansible/, inventory/, environments/ excluding example/)
HAS_INFRA=0
for f in $STAGED; do
    case "$f" in
        ansible/*|inventory/*|environments/*/datasets/*|environments/*/ansible/*)
            case "$f" in
                environments/example/*) ;;
                *) HAS_INFRA=1; break ;;
            esac
            ;;
    esac
done

if [ $HAS_INFRA -eq 0 ]; then
    exit 0
fi

# Published commit messages use the neutral TKT-<num> form; the full
# client-identifying <PREFIX>-<num> ID lives only in .current-ticket and the
# helpdesk (docs/client-data-policy.md).
if ! echo "$COMMIT_MSG" | grep -qiE "^TKT-[0-9]+:"; then
    echo "ERROR: Infrastructure changes require a TKT-XXXX ticket reference."
    echo "  Add 'TKT-XXXX: ...' (number only — never the client's helpdesk prefix)."
    echo "  Active ticket: $(python3 bin/active_ticket.py --verbose 2>/dev/null || echo unresolved)"
    exit 1
fi

exit 0
